{
  "name": "uptime-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-09",
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "uptime",
      "id": "0c6ff2a5b9e6439cb855ea16e08bfd58",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "Monitor",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Monitor"],
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
