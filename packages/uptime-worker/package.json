{
  "name": "@hobroker/uptime-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled",
    "cf-typegen": "wrangler types",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "lint": "eslint \"**/*.{ts,mjs,json}\"",
    "lint:fix": "npm run lint -- --fix",
    "ts-check": "wrangler types && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@hobroker/uptime-eslint": "*",
    "@hobroker/uptime-test": "*",
    "@hobroker/uptime-tsconfig": "*",
    "eslint": "^v10.8.1",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "liquidjs": "^10.29.0"
  }
}
